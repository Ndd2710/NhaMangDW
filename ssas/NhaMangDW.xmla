              <Commands>
                <Command>
                  <Text>CALCULATE; CREATE MEMBER CURRENTCUBE.[Measures].[Don Gia Ban Binh Quan] AS IIF([Measures].[So Luong Ban]=0,NULL,[Measures].[Doanh Thu Ban Hang]/[Measures].[So Luong Ban]), FORMAT_STRING='#,##0.00', VISIBLE=1; CREATE MEMBER CURRENTCUBE.[Measures].[Don Gia Mua Binh Quan] AS IIF([Measures].[So Luong Mua]=0,NULL,[Measures].[Thanh Tien Mua]/[Measures].[So Luong Mua]),FORMAT_STRING='#,##0.00',ASSOCIATED_MEASURE_GROUP='Fact Mua Hang'; CREATE MEMBER CURRENTCUBE.[Measures].[So Phut Trung Binh Moi Cuoc] AS IIF([Measures].[So Cuoc Goi]=0,NULL,[Measures].[So Phut Goi]/[Measures].[So Cuoc Goi]),FORMAT_STRING='0.00',ASSOCIATED_MEASURE_GROUP='Fact Cuoc Goi'; CREATE MEMBER CURRENTCUBE.[Measures].[Don Gia Thoai Binh Quan] AS IIF([Measures].[So Phut Goi]=0,NULL,[Measures].[Doanh Thu Thoai]/[Measures].[So Phut Goi]),FORMAT_STRING='#,##0.00',ASSOCIATED_MEASURE_GROUP='Fact Cuoc Goi'; CREATE MEMBER CURRENTCUBE.[Measures].[Don Gia Data Binh Quan] AS IIF([Measures].[Dung Luong Data MB]=0,NULL,[Measures].[Doanh Thu Data]/[Measures].[Dung Luong Data MB]),FORMAT_STRING='#,##0.00',ASSOCIATED_MEASURE_GROUP='Fact Cuoc Goi';</Text>
                </Command>
              </Commands>
            </MdxScript>
